&pinctrl {
    rled_pin0:rled_pin0{
        group1{
            pinmux = <PWM_3A_P6>;
        };
    };
};


&pwm {
    status ="okay";
    pinctrl-0 = <&rled_pin0>;
    pinctrl-names = "default";
    divider-int-3 = <125>;
};


/{

    aliases{
        rled = &rled;
    };

    pwmled{
        compatible = "pwm-leds";
        rled:rled{
            pwms = <&pwm 6 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
            label = "Rled";
        };
    };
};

